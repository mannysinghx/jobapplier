# Copy to .env and fill in. Never commit .env.
# Generate the encryption key with:  cd backend && .venv/bin/python -m app.cli gen-key
# BACK IT UP SEPARATELY: without it, encrypted files and fields cannot be recovered.
JA_ENCRYPTION_KEY=

POSTGRES_USER=jobapplier
POSTGRES_PASSWORD=
POSTGRES_DB=jobapplier

# true when served over HTTPS (reverse proxy)
JA_COOKIE_SECURE=false

# set to "clamav" when running `docker compose --profile av up -d`
JA_CLAMAV_HOST=

# Local development (no Docker). Defaults: SQLite in ./data, Redis at localhost:6389
# JA_DATABASE_URL=sqlite:///./data/dev.sqlite3
# JA_REDIS_URL=redis://localhost:6389/0
